+ if (!enable && !s->owned) return 0;
+ if (o->read(p, 0x23, &before_word)) return -5;
+ if (s->owned && before_word != s->last && before_word != s->previous && before_word != s->original) {
+  /* Another configuration owns this word. Never restore over it. */
+  s->owned = 0;
+  return -116;
