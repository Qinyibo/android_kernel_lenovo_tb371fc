+static int nvt_panel_resume_prepare(struct device *dev, uint32_t id)
+{
+    int ret;
+#if NVT_HALL_CHECK
+    cancel_delayed_work_sync(&nvt_hall_check_work);
+#endif
+    if (!id)
+        return -EINVAL;
+    if (nvt_panel_resume_pending)
+        return nvt_panel_resume_id == id ? 0 : -EBUSY;
+    if (bTouchIsAwake && !READ_ONCE(nvt_runtime_fw_failed)) {
+        mutex_lock(&ts->lock);
+        (void)nvt_irq_wake_ctrl_locked(false);
+        mutex_unlock(&ts->lock);
+        nvt_panel_resume_id = id;
+        return 0;
+    }
+    nvt_panel_resume_id = id;
+    nvt_irq_enable(false);
+    mutex_lock(&ts->lock);
+    (void)nvt_irq_wake_ctrl_locked(false);
+#if NVT_HALL_CHECK
+    WRITE_ONCE(nvt_hall_pm, 0);
+    WRITE_ONCE(nvt_hall_pm_status, 0);
+#endif
+    if (READ_ONCE(nvt_runtime_fw_failed))
+        bTouchIsAwake = 0;
+    if (bTouchIsAwake || nvt_panel_resume_pending) {
+        mutex_unlock(&ts->lock);
+        return -EBUSY;
+    }
+#if NVT_TOUCH_SUPPORT_HW_RST
+    gpio_set_value(ts->reset_gpio, 1);
