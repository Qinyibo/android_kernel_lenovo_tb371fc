+#endif
+	nvt_irq_enable(false);
+	mutex_lock(&ts->lock);
+	(void)nvt_irq_wake_ctrl_locked(false);
+#if NVT_HALL_CHECK
+	WRITE_ONCE(nvt_hall_pm, 0);
+	WRITE_ONCE(nvt_hall_pm_status, 0);
+#endif
+	bTouchIsAwake = 0;
+	nvt_panel_suspend_from_awake = false;
+	nvt_panel_suspend_pending_abort = false;
+	nvt_panel_resume_armed = false;
+	WRITE_ONCE(nvt_panel_resume_pending, false);
+#if defined(CONFIG_DRM_PANEL)
+	nvt_panel_resume_id = 0;
+#endif
+	if (mark_failed)
+		WRITE_ONCE(nvt_panel_resume_failed, true);
+	mutex_unlock(&ts->lock);
+}
