+#if BOOT_UPDATE_FIRMWARE && defined(CONFIG_DRM_PANEL)
+/* R94v37: the one-shot boot download belongs to the same transition owner
+ * as PREPARE/ARM/COMMIT/suspend. Never wait for a work item under this mutex.
+ * Skipping while asleep/pending is intentional: the next PREPARE performs
+ * the complete download before DSI, with its existing REK/COMMIT gate. */
+static void Boot_Update_Firmware(struct work_struct *work)
+{
+    int ret;
+
+    mutex_lock(&nvt_panel_transition_lock);
+    if (nvt_panel_fw_restored) {
+        NVT_LOG("R94_BOOT_FW_SKIP already_prepared\n");
+        goto out_owner;
+    }
+    if (READ_ONCE(nvt_stopping) || !bTouchIsAwake || nvt_panel_resume_pending ||
+        nvt_panel_resume_armed || nvt_panel_resume_failed) {
+        NVT_LOG("R94_BOOT_FW_DEFER awake=%u pending=%u armed=%u failed=%u\n",
+                bTouchIsAwake, nvt_panel_resume_pending,
+                nvt_panel_resume_armed, nvt_panel_resume_failed);
+        goto out_owner;
+    }
+
+    /* IRQ thread takes ts->lock: drain it before taking that lock. */
+    nvt_irq_enable(false);
+    nvt_release_touches();
+    mutex_lock(&ts->lock);
+    (void)nvt_irq_wake_ctrl_locked(false);
+    ret = nvt_update_firmware(BOOT_UPDATE_FIRMWARE_NAME);
+    if (!ret)
+        ret = nvt_check_fw_reset_state(RESET_STATE_REK);
+    if (!ret) {
+        get_tp_info();
+        nvt_panel_fw_restored = true;
+        WRITE_ONCE(nvt_runtime_fw_failed, false);
+    } else {
+        bTouchIsAwake = 0;
+        WRITE_ONCE(nvt_panel_resume_failed, true);
+    }
+    mutex_unlock(&ts->lock);
+    if (ret) {
+        NVT_ERR("R94_BOOT_FW_FAILED %d IRQ_CLOSED next_PREPARE_owns_recovery\n", ret);
+        goto out_owner;
+    }
+
+    /* The setters acquire ts->lock themselves. Keep the transition owner
+     * until restore and IRQ reopening finish, so OFF cannot overtake them. */
+#if NVT_CUST_PROC_CMD
+    nvt_restore_cmd_func(work);
+#endif
+    nvt_irq_enable(true);
+    NVT_LOG("R94_BOOT_FW_VERIFIED real_REK_verified IRQ_OPEN\n");
+out_owner:
+    mutex_unlock(&nvt_panel_transition_lock);
+}
+#endif
