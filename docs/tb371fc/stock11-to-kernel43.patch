+static int32_t nvt_ts_pre_suspend(struct device *dev)
+{
+	bool was_awake = READ_ONCE(bTouchIsAwake);
+	bool resume_prepared = READ_ONCE(nvt_panel_resume_pending);
+
+	/* A duplicate EARLY_OFF must preserve a committed gesture/Hall session. */
+	if (!was_awake && !resume_prepared)
+		return 0;
+#if NVT_HALL_CHECK
+	cancel_delayed_work_sync(&nvt_hall_check_work);
+#endif
+	nvt_irq_enable(false);
+#if NVT_TOUCH_ESD_PROTECT
+	NVT_LOG("cancel delayed work sync\n");
+	cancel_delayed_work_sync(&nvt_esd_check_work);
+	nvt_esd_check_enable(false);
+#endif
+	mutex_lock(&ts->lock);
+	(void)nvt_irq_wake_ctrl_locked(false);
+#if NVT_HALL_CHECK
+	WRITE_ONCE(nvt_hall_pm, 0);
+	WRITE_ONCE(nvt_hall_pm_status, 0);
+#endif
+	if (bTouchIsAwake) {
+		nvt_panel_suspend_from_awake = true;
+		nvt_panel_suspend_pending_abort = false;
+	} else if (nvt_panel_resume_pending) {
+		nvt_panel_suspend_from_awake = false;
+		nvt_panel_suspend_pending_abort = true;
+		WRITE_ONCE(nvt_panel_resume_failed, true);
+	}
+	bTouchIsAwake = 0;
+	nvt_panel_resume_armed = false;
+	WRITE_ONCE(nvt_panel_resume_pending, false);
+#if defined(CONFIG_DRM_PANEL)
+	nvt_panel_resume_id = 0;
+#endif
+	mutex_unlock(&ts->lock);
+
+	nvt_release_touches();
+	return 0;
+}
