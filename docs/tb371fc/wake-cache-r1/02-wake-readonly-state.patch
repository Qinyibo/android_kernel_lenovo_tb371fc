+        READ_ONCE(r94_wake_irq_armed), READ_ONCE(r94_wake_gestures),
+        READ_ONCE(r94_wake_last_gesture), READ_ONCE(r94_wake_pm_timeouts));
+}
+
+static const struct kernel_param_ops r94_wake_state_ops = {
+    .get = r94_wake_state_get,
